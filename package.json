{
  "name": "__PRODUCT__-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "__Product__ — started from krizaka/template-next-app.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@__PRODUCT__/web",
    "build": "turbo run build",
    "lint:workspace": "npx --yes -p @krizaka/config@latest krizaka-workspace-guard",
    "lint": "pnpm run lint:workspace && turbo run lint && pnpm run check:i18n && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run && node --test scripts/init.test.mjs scripts/check-template-drift.test.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "init": "node scripts/init.mjs",
    "drift": "node scripts/check-template-drift.mjs",
    "seo:check": "node scripts/check-seo-family.mjs --base http://localhost:3000 --host https://www.__PRODUCT__.com --types WebSite,SoftwareApplication",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/i18n": "^0.2.1",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Krizaka"
}
